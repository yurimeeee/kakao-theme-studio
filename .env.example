# Kakao Theme Studio — environment example
#
# Without the Firebase values below the app runs local-only (1차 behaviour): everything
# stays in this browser (IndexedDB) and cloud features (로그인, 내 테마, 공유, 둘러보기)
# are hidden. Copy to `.env.local` for a real Firebase project.
#
# These are PUBLIC web-client values. Never put server secrets, Firebase Admin credentials
# or the Kakao client secret in VITE_ variables — they are bundled into client code.
# Server-side values live in Cloud Functions params/secrets (see docs/cloud.md §9).

# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional (defaults: <project>.firebaseapp.com / <project>.appspot.com)
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional, must match setGlobalOptions in functions/src/index.ts (default asia-northeast3)
VITE_FIREBASE_FUNCTIONS_REGION=

# Kakao Developers → 앱 키 → REST API 키 (OAuth client_id, public). Empty = 카카오 로그인 준비 중.
VITE_KAKAO_REST_API_KEY=

# Optional App Check: Firebase console → App Check → 웹 앱 → reCAPTCHA Enterprise site key (public).
# With it set, deploy functions with REQUIRE_APP_CHECK=true so un-attested download counts are ignored.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local Firebase Emulator Suite only (demo-* project ids). See `.env.emulator` / `pnpm dev:cloud`.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
