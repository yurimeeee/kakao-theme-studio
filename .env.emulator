# Used by `vite --mode emulator` (pnpm dev:cloud, pnpm e2e:cloud): talks to the local
# Firebase Emulator Suite under a demo-* project. No real Firebase project or secret involved.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-kakao-theme-studio
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
